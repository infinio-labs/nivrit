{
  "name": "nivrit-web",
  "private": true,
  "version": "2.0.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "build:wasm": "cd ../nivrit-web-crypto && wasm-pack build --target bundler --out-dir ../nivrit-web/src/wasm/pkg",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --config playwright-standalone.config.ts"
  },
  "dependencies": {
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.10"
  }
}

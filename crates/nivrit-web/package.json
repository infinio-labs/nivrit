{
  "name": "nivrit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:wasm": "cd ../nivrit-web-crypto && wasm-pack build --target bundler --out-dir ../nivrit-web/src/wasm/pkg",
    "dev": "vite",
    "build": "bun run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "lucide-react": "^1.18.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "bun-types": "1.3.14",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-top-level-await": "1.5.0",
    "vite-plugin-wasm": "3.4.1",
    "@playwright/test": "^1.60.0"
  }
}

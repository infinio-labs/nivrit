  "query": "\n        INSERT INTO project_key_versions (project_id, version, created_by)\n        SELECT $1, COALESCE(MAX(version), 0) + 1, $2\n        FROM project_key_versions WHERE project_id = $1\n        RETURNING id, project_id, version, created_at, created_by\n        ",

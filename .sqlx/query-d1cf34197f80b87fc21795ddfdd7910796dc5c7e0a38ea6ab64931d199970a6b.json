  "query": "\n        SELECT t.id, t.project_id, t.name, t.color, t.created_at\n        FROM tags t\n        JOIN secret_tags st ON st.tag_id = t.id\n        WHERE st.secret_id = $1\n        ORDER BY t.name ASC\n        ",

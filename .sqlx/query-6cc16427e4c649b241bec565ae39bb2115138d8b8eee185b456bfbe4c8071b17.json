{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, project_id, environment_id, folder_id, key, encrypted_value, nonce, algorithm, version, created_at, updated_at\n        FROM secrets\n        WHERE project_id = $1\n          AND ($2::uuid IS NULL OR environment_id = $2)\n          AND folder_id IS NOT DISTINCT FROM $3\n        ORDER BY key ASC\n        LIMIT $4 OFFSET $5\n        ",

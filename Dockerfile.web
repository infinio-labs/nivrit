# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

# -----------------------------------------------------------------------------
# Build stage: compile the Vite + React frontend.
# -----------------------------------------------------------------------------
FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS builder

WORKDIR /app

# Install dependencies first so Docker can cache this layer.
COPY crates/nivrit-web/package.json crates/nivrit-web/bun.lock ./
RUN bun install --frozen-lockfile

# Copy the rest of the frontend source, including the checked-in WASM package.
COPY crates/nivrit-web/ ./

# Build for production. The WASM package is already checked in; we skip the
# wasm-pack build step and point the API client at the Caddy-proxied /api path.
ENV VITE_API_URL=/api
ENV CI=true
RUN bun run typecheck && bun run build
# The crypto WASM package is loaded dynamically at runtime from a path relative
# to the bundled JS chunk, so Vite does not automatically copy it into dist.
RUN mkdir -p dist/assets/wasm/pkg && cp -r src/wasm/pkg/* dist/assets/wasm/pkg/

# -----------------------------------------------------------------------------
# Extract the statically-linked Caddy binary. The official binary is built
# with CGO_ENABLED=0 (confirmed with `ldd` -- "not a dynamic program"), so it
# runs on `distroless/static`, not just `distroless/cc`: no libc needed at
# all, just the binary and the CA cert bundle distroless/static already ships.
# -----------------------------------------------------------------------------
FROM caddy:2.11-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648 AS caddy-bin

# -----------------------------------------------------------------------------
# Runtime stage: serve static files and reverse-proxy /api with Caddy instead
# of nginx. nginx.web.conf did three jobs -- security headers, SPA fallback
# routing, and reverse-proxying /api/ to the backend -- and Caddyfile does all
# three too, so this is a size/attack-surface swap, not a behavior change.
# `:nonroot` runs as a built-in unprivileged user; Caddy listens on 8080
# because nonroot can't bind the privileged port 80.
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a AS runtime

COPY --from=caddy-bin /usr/bin/caddy /usr/bin/caddy
COPY --from=builder /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 8080

ENTRYPOINT ["/usr/bin/caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

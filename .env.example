# Database
DATABASE_URL=postgres://nivrit:nivrit@localhost:5432/nivrit

# Server
NIVRIT_HOST=127.0.0.1
NIVRIT_PORT=4000
NIVRIT_LOG_LEVEL=info

# Optional: enable TLS 1.3 with post-quantum hybrid key exchange (X25519MLKEM768).
# Generate a dev cert with: ./scripts/generate-dev-cert.sh
# NIVRIT_TLS_CERT_PATH=certs/dev.crt
# NIVRIT_TLS_KEY_PATH=certs/dev.key

# Auth
# REQUIRED: >= 32 bytes. The server refuses to start with a short or placeholder
# value. Generate one with: openssl rand -hex 32
NIVRIT_AUTH_SECRET=change-this-to-a-random-32-byte-secret-key
NIVRIT_TOKEN_EXPIRY_SECONDS=3600

# Frontend dev proxy
VITE_API_URL=http://localhost:4000

# CORS: set to the deployed frontend origin in production.
# If omitted, CORS allows any origin (development only).
# NIVRIT_CORS_ORIGIN=https://app.example.com

# OAuth (optional; leave blank to disable social login)
NIVRIT_OAUTH_REDIRECT_URL=http://localhost:8080/oauth/callback
# NIVRIT_GOOGLE_CLIENT_ID=
# NIVRIT_GOOGLE_CLIENT_SECRET=
# NIVRIT_GITHUB_CLIENT_ID=
# NIVRIT_GITHUB_CLIENT_SECRET=

# Email (log prints reset links to stdout; smtp sends real emails)
NIVRIT_EMAIL_MODE=log
# NIVRIT_SMTP_HOST=smtp.example.com
# NIVRIT_SMTP_PORT=587
# NIVRIT_SMTP_USER=
# NIVRIT_SMTP_PASS=
# NIVRIT_SMTP_FROM=

# TOTP secret encryption (base64-encoded 32-byte AES key)
# Generate with: openssl rand -base64 32
NIVRIT_TOTP_ENCRYPTION_KEY=change-me-to-a-base64-32-byte-key


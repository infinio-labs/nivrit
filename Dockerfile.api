# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

# -----------------------------------------------------------------------------
# Build stage for the Nivrit API server.
# -----------------------------------------------------------------------------
FROM rust:1.97.1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS builder

WORKDIR /usr/src/nivrit

# Install native dependencies required by sqlx / rustls build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        pkg-config=1.8.1-1 \
        libssl-dev=3.0.20-1~deb12u2 \
    && rm -rf /var/lib/apt/lists/*

# Build offline using the checked-in SQLx query metadata.
ENV SQLX_OFFLINE=true

# Copy workspace manifests, source, the SQLx offline query metadata, and the
# Rust SDK crate (referenced as a workspace member).
COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx
COPY crates ./crates
COPY sdks/rust ./sdks/rust

# Build the release binary. The cache mounts keep dependency downloads and
# intermediate artifacts across rebuilds without bloating the final image.
# Migrations are embedded at compile time (`sqlx::migrate!` in
# `nivrit-db::DbPool::migrate`) -- the binary applies its own schema at
# startup, so nothing else needs to ship in the runtime image to do it.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    CARGO_TARGET_DIR=/build/target cargo build --release -p nivrit-api \
    && cp /build/target/release/nivrit-api /usr/local/bin/nivrit-api

# -----------------------------------------------------------------------------
# Runtime stage: distroless, not debian-slim. `nivrit-api` links only libc,
# libgcc, and libm at runtime (verified with `ldd` -- rustls + aws-lc-rs are
# statically linked, there is no OpenSSL dependency), so it needs nothing a
# general-purpose Debian userland provides: no shell, no package manager, no
# apt packages, no separate `sqlx-cli` binary for migrations, no `curl` for
# the healthcheck (both of those are now `nivrit-api` itself -- see below and
# `DbPool::migrate`). `:nonroot` runs as a built-in unprivileged user, so
# there's no `useradd`/`USER` step either.
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/cc-debian12:nonroot@sha256:fccdbb0a547c14e23fcf4ce8ad62ca5d43b4faae8d22cd292f490fef9946c96e AS runtime

COPY --from=builder /usr/local/bin/nivrit-api /usr/local/bin/nivrit-api

# No runtime configuration is baked into the image: host/port default in code,
# everything else (DATABASE_URL, secrets, OAuth, SMTP, ...) is injected at
# runtime. EXPOSE is metadata only, not an environment variable.
EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/nivrit-api"]

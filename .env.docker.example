# Runtime configuration for the published Nivrit API image.
#
# Nothing is baked into the image — every value below is injected at runtime
# (compose env_file, Kubernetes Secret/ConfigMap, etc.). Copy this file to
# .env.docker for local `docker compose up`, or map the same keys into your
# orchestrator's secret store in production.
#
#   cp .env.docker.example .env.docker   # then fill in the REQUIRED values

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Postgres connection string. In the bundled compose stack this is overridden to
# point at the `postgres` service; set it explicitly for any other deployment.
DATABASE_URL=postgres://user:password@host:5432/nivrit

# JWT signing secret. MUST be >= 32 bytes and not a placeholder, or the API
# refuses to start.  Generate:  openssl rand -hex 32
NIVRIT_AUTH_SECRET=

# AES key (base64-encoded 32 bytes) that encrypts stored TOTP secrets.
# Generate:  openssl rand -base64 32
NIVRIT_TOTP_ENCRYPTION_KEY=

# ── OPTIONAL (sensible code defaults shown) ──────────────────────────────────

# NIVRIT_HOST=0.0.0.0
# NIVRIT_PORT=4000
# NIVRIT_LOG_LEVEL=info
# NIVRIT_LOG_FORMAT=json          # "json" for log aggregators, "pretty" for humans
# NIVRIT_TOKEN_EXPIRY_SECONDS=3600

# Observability: GET /metrics exposes Prometheus metrics, GET /health is liveness,
# GET /ready checks the database. Restrict /metrics to your internal network — do
# not expose it publicly.

# Allowed CORS origin. Omit only in development (allows any origin).
# NIVRIT_CORS_ORIGIN=https://app.example.com

# Base64 32-byte seed for ML-DSA-65 audit-log signing. Omit to disable signatures.
# NIVRIT_SIGNING_KEY_SEED=

# Optional pepper mixed into recovery-code hashing.
# NIVRIT_RECOVERY_CODE_PEPPER=

# TLS (omit to serve plain HTTP behind a TLS-terminating proxy).
# NIVRIT_TLS_CERT_PATH=/certs/tls.crt
# NIVRIT_TLS_KEY_PATH=/certs/tls.key

# OAuth (leave blank to disable social login).
# NIVRIT_OAUTH_REDIRECT_URL=https://app.example.com/oauth/callback
# NIVRIT_GOOGLE_CLIENT_ID=
# NIVRIT_GOOGLE_CLIENT_SECRET=
# NIVRIT_GITHUB_CLIENT_ID=
# NIVRIT_GITHUB_CLIENT_SECRET=

# Email (log = print reset links to stdout; smtp = send real mail).
# NIVRIT_EMAIL_MODE=log
# NIVRIT_SMTP_HOST=
# NIVRIT_SMTP_PORT=587
# NIVRIT_SMTP_USER=
# NIVRIT_SMTP_PASS=
# NIVRIT_SMTP_FROM=
